# Copy this file to .env locally. Do not commit .env.
# Placeholder only; URL-encode username/password if using this SQLAlchemy URL.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/fraud_detection
# Separate settings avoid placing a password in a URL or shell command.
DB_HOST=YOUR_RDS_ENDPOINT
DB_PORT=3306
DB_NAME=fraud_detection
DB_USER=YOUR_APPLICATION_USER
DB_PASSWORD=
# Download the current RDS CA bundle from AWS. Use its absolute local path.
DB_SSL_CA=PATH_TO_RDS_CA_BUNDLE
DB_SSL_VERIFY_CERT=true
DB_SSL_VERIFY_IDENTITY=true
# .env is not loaded automatically. Choose one configuration style in the ETL;
# never silently disable TLS or fall back to different credentials.
MLFLOW_TRACKING_URI=https://YOUR-MLFLOW-SERVER
MLFLOW_EXPERIMENT_NAME=amlop-ca1-fraud
